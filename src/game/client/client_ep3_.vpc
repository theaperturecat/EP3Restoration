$Macro SRCDIR		"..\.."
$Macro GAMENAME 	"ep3"

$Include "$SRCDIR\game\client\client_base.vpc"

$Configuration
{
	$Compiler
	{
		$AdditionalIncludeDirectories	".\hl2;.\hl2\gameui\;.\hl2\elements;.\ep3;.\episodic;$SRCDIR\game\shared\hl2;$SRCDIR\game\shared\episodic;$SRCDIR\game\shared\ep3;$BASE"
		$PreprocessorDefinitions		"$BASE;HL2_CLIENT_DLL;HL2_EPISODIC;USE_BLOBULATOR;HL2_EP3;GAMEUI_EMBEDDED;GAMEUI_EXPORTS"
	}
}

